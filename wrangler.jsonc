{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "movoka",
  "main": "./worker.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "MOVIE_DATA",
      "id": "REPLACE_WITH_MOVOKA_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": ["0 18 * * *"]
  }
}
