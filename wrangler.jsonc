{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movoka-preview",
  "main": "worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/performance/*", "/robots.txt", "/favicon.ico", "/favicon.svg", "/og-image.png"]
  }
}
