{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "movoka",
  "main": "worker.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": ["KOPIS_API_KEY"]
  }
}
